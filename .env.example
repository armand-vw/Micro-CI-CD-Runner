# ---------------------------------------------------------------------------
# Micro-CI/CD Runner configuration
# Copy this file to .env and fill in the required values.
# ---------------------------------------------------------------------------

# HTTP port the runner listens on.
PORT=8080

# SQLite database file. The parent directory is created automatically.
DB_PATH=./data/runner.db

# YAML file describing the projects this runner may build.
PROJECTS_FILE=./config/projects.yaml

# REQUIRED. The same secret configured on the GitHub webhook.
# Generate one with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Optional. Needed only to clone private repositories.
GITHUB_TOKEN=

# Docker daemon endpoint. Defaults to the local Unix socket.
DOCKER_HOST=unix:///var/run/docker.sock

# Maximum number of builds that may run at the same time.
MAX_CONCURRENT_BUILDS=1

# Maximum number of builds waiting in the queue.
QUEUE_SIZE=100

# Hard timeout for a single build.
BUILD_TIMEOUT=15m

# Maximum log bytes kept per build (default 2 MiB).
LOG_MAX_BYTES=2097152

# Optional bearer token required to trigger retries through the API.
ADMIN_TOKEN=

# Optional public URL used when generating links outside of the request.
PUBLIC_BASE_URL=

# Optional comma-separated allowlist for browser origins (e.g. a GitHub Pages UI).
ALLOWED_ORIGINS=

# Log verbosity: debug, info, warn, error.
LOG_LEVEL=info
